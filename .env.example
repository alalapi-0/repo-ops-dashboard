# Copy to .env and fill in (.env is gitignored; this file is safe to commit)

# ── LLM (Round 22, opt-in — set LLM_ENABLED=true and use --llm-summary --call)
LLM_ENABLED=false
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-pro
LLM_MAX_TOKENS=2048

# ── Generation pipeline auto-approve (local e2e tests only; production stays manual)
AUTO_APPROVE_GENERATIONS=false
REVIEW_MODE=manual
SKIP_HUMAN_REVIEW=false
# Optional OpenRouter attribution (not secrets):
# OPENROUTER_HTTP_REFERER=https://github.com/you/repo-ops-dashboard
# OPENROUTER_X_TITLE=repo-ops-dashboard

# ── Feishu group bot (Round 08 / 16)
FEISHU_WEBHOOK_URL=
# Optional if bot uses signature verification:
# FEISHU_SIGN_SECRET=

# ── Feishu Bitable sync (Round 17) — tenant app credentials, never commit
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_BITABLE_APP_TOKEN=
# FEISHU_BITABLE_TABLE_ID=
